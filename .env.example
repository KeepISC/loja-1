DATABASE_URL="file:../database/dev.db"
PORT=3001
# Local mode generates an ephemeral role-session secret if omitted/weak.
# For remote testing set a random secret of at least 32 characters in your shell.
SESSION_SECRET=""
NODE_ENV="development"
ALLOW_MOCK_PAYMENT=true
# Optional HTTPS URL of a full marketplace for email order buttons. Omit for local HTTP/Pages demos.
# EMAIL_APP_URL=https://marketplace.example
# Authentication email is separate from the order-email mock provider.
# Put private SMTP settings in ignored .env.auth-email.local, never this template.
AUTH_EMAIL_TRANSPORT=preview
AUTH_APP_ORIGIN=http://localhost:5173
# SMTP requires a trusted HTTPS AUTH_APP_ORIGIN and AUTH_EMAIL_TRANSPORT=smtp.
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=security@your-owned-domain.example
# SMTP_FROM=security@your-owned-domain.example
# SMTP_PASS=REPLACE_LOCALLY
# SMTP_TIMEOUT_MS=10000
# AUTH_EMAIL_ENCRYPTION_KEY=GENERATE_LOCALLY_32_RANDOM_BYTES_BASE64URL
# Optional private, guest-only remote tests. See SECURITY_REMOTE_TESTING.md first.
REMOTE_TESTING=false
# REMOTE_ORIGIN=https://shop-test.your-domain.example
