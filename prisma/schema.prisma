generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String           @id @default(uuid())
  role        String
  displayName String
  email       String           @unique
  createdAt   DateTime         @default(now())
  orders      Order[]
  account     Account?
  supplier    SupplierProfile?
}

model Account {
  userId          String      @id
  passwordHash    String
  emailVerifiedAt DateTime?
  sessionVersion  Int         @default(0)
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokens          AuthToken[]
  messages        AuthEmail[]
}

model AuthToken {
  idHash    String    @id
  userId    String
  purpose   String
  expiresAt DateTime
  usedAt    DateTime?
  account   Account   @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, purpose])
  @@index([expiresAt])
}

// Local email adapter only; bearer links belong in the private development outbox.
model AuthEmail {
  id        String   @id @default(uuid())
  userId    String
  recipient String
  subject   String
  body      String
  createdAt DateTime @default(now())
  account   Account  @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AuthRateLimit {
  keyHash   String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

// A separate profile allows a later application/approval lifecycle without
// granting access through registration or changing existing contact ownership.
model SupplierProfile {
  userId   String            @id
  active   Boolean           @default(false)
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts SupplierContact[]
}

model SiteSetting {
  key   String @id
  value String
}

model Session {
  idHash    String   @id
  data      String
  expiresAt DateTime

  @@index([expiresAt])
}

model Category {
  id          String            @id @default(uuid())
  name        String
  slug        String            @unique
  description String
  priceCents  Int
  imageUrl    String
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  contacts    SupplierContact[]
  items       OrderItem[]
}

model SupplierContact {
  id           String           @id @default(uuid())
  categoryId   String
  supplierName String
  email        String
  telephone    String?
  whatsapp     String?
  website      String?
  notes        String?
  category     Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  supplierId   String?
  supplier     SupplierProfile? @relation(fields: [supplierId], references: [userId], onDelete: SetNull)

  @@index([categoryId])
  @@index([supplierId])
}

model Order {
  id            String         @id @default(uuid())
  orderNumber   String         @unique
  userId        String?
  customerEmail String
  status        String         @default("PENDING")
  totalCents    Int
  createdAt     DateTime       @default(now())
  user          User?          @relation(fields: [userId], references: [id])
  items         OrderItem[]
  payment       Payment?
  emailDelivery EmailDelivery?

  @@index([userId, createdAt])
}

model OrderItem {
  id           String   @id @default(uuid())
  orderId      String
  categoryId   String
  categoryName String
  priceCents   Int
  quantity     Int      @default(1)
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  category     Category @relation(fields: [categoryId], references: [id])

  @@index([orderId])
  @@index([categoryId])
}

model Payment {
  id          String    @id @default(uuid())
  orderId     String    @unique
  status      String    @default("PENDING")
  provider    String    @default("DUMMY")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  confirmedAt DateTime?
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model EmailDelivery {
  id        String   @id @default(uuid())
  orderId   String   @unique
  status    String   @default("NOT_SENT")
  recipient String
  subject   String
  body      String
  attempts  Int      @default(0)
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}
