generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/mysql-client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id          String           @id @default(uuid()) @db.VarChar(128)
  role        String           @db.VarChar(20)
  displayName String           @db.VarChar(255)
  email       String           @unique @db.VarChar(254)
  createdAt   DateTime         @default(now())
  orders      Order[]
  account     Account?
  supplier    SupplierProfile?
}

model Account {
  userId          String      @id @db.VarChar(128)
  passwordHash    String      @db.VarChar(255)
  emailVerifiedAt DateTime?
  sessionVersion  Int         @default(0)
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokens          AuthToken[]
  messages        AuthEmail[]
}

model AuthToken {
  idHash    String    @id @db.Char(64)
  userId    String    @db.VarChar(128)
  purpose   String    @db.VarChar(20)
  expiresAt DateTime
  usedAt    DateTime?
  account   Account   @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, purpose])
  @@index([expiresAt])
}

// Local email adapter only; bearer links belong in the private development outbox.
model AuthEmail {
  id        String   @id @default(uuid()) @db.VarChar(128)
  userId    String   @db.VarChar(128)
  recipient String   @db.VarChar(254)
  subject   String   @db.VarChar(255)
  body      String   @db.LongText
  createdAt DateTime @default(now())
  account   Account  @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AuthRateLimit {
  keyHash   String   @id @db.Char(64)
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

// A separate profile allows a later application/approval lifecycle without
// granting access through registration or changing existing contact ownership.
model SupplierProfile {
  userId   String            @id @db.VarChar(128)
  active   Boolean           @default(false)
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts SupplierContact[]
}

model SiteSetting {
  key   String @id @db.VarChar(191)
  value String @db.VarChar(255)
}

model Session {
  idHash    String   @id @db.Char(64)
  data      String   @db.LongText
  expiresAt DateTime

  @@index([expiresAt])
}

model Category {
  id          String            @id @default(uuid()) @db.VarChar(128)
  name        String            @db.VarChar(80)
  slug        String            @unique @db.VarChar(80)
  description String            @db.Text
  priceCents  Int
  imageUrl    String            @db.Text
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  contacts    SupplierContact[]
  items       OrderItem[]
}

model SupplierContact {
  id           String           @id @default(uuid()) @db.VarChar(128)
  categoryId   String           @db.VarChar(128)
  supplierName String           @db.VarChar(80)
  email        String           @db.VarChar(254)
  telephone    String?          @db.VarChar(80)
  whatsapp     String?          @db.VarChar(80)
  website      String?          @db.VarChar(200)
  notes        String?          @db.Text
  category     Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  supplierId   String?          @db.VarChar(128)
  supplier     SupplierProfile? @relation(fields: [supplierId], references: [userId], onDelete: SetNull)

  @@index([categoryId])
  @@index([supplierId])
}

model Order {
  id            String         @id @default(uuid()) @db.VarChar(128)
  orderNumber   String         @unique @db.VarChar(80)
  userId        String?        @db.VarChar(128)
  customerEmail String         @db.VarChar(254)
  status        String         @default("PENDING") @db.VarChar(20)
  totalCents    Int
  currency      String @default("EUR") @db.VarChar(3)
  createdAt     DateTime       @default(now())
  user          User?          @relation(fields: [userId], references: [id])
  items         OrderItem[]
  payment       Payment?
  emailDelivery EmailDelivery?

  @@index([userId, createdAt])
}

model OrderItem {
  id           String   @id @default(uuid()) @db.VarChar(128)
  orderId      String   @db.VarChar(128)
  categoryId   String   @db.VarChar(128)
  categoryName String   @db.VarChar(80)
  priceCents   Int
  quantity     Int      @default(1)
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  category     Category @relation(fields: [categoryId], references: [id])

  @@index([orderId])
  @@index([categoryId])
}

model Payment {
  id          String    @id @default(uuid()) @db.VarChar(128)
  orderId     String    @unique @db.VarChar(128)
  status      String    @default("PENDING") @db.VarChar(20)
  provider    String    @default("DUMMY") @db.VarChar(20)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  confirmedAt DateTime?
  paymentIntentId String? @unique @db.VarChar(255)
  refundedCents Int @default(0)
  attempts PaymentAttempt[]
  events PaymentEvent[]
  refunds PaymentRefund[]
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model EmailDelivery {
  id        String   @id @default(uuid()) @db.VarChar(128)
  orderId   String   @unique @db.VarChar(128)
  status    String   @default("NOT_SENT") @db.VarChar(20)
  recipient String   @db.VarChar(254)
  subject   String   @db.VarChar(255)
  body      String   @db.LongText
  attempts  Int      @default(0)
  lastError String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model PaymentAttempt {
  id String @id @default(uuid()) @db.VarChar(36)
  paymentId String @db.VarChar(36)
  status String @default("CREATING") @db.VarChar(80)
  sessionId String? @unique @db.VarChar(255)
  intentId String? @unique @db.VarChar(255)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
}

model PaymentEvent {
  id String @id @default(uuid()) @db.VarChar(36)
  eventId String? @unique @db.VarChar(255)
  paymentId String @db.VarChar(36)
  kind String @db.VarChar(80)
  status String @db.VarChar(80)
  amountCents Int
  currency String @db.VarChar(3)
  actorId String? @db.VarChar(36)
  createdAt DateTime @default(now())
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
}

model PaymentRefund {
  id String @id @default(uuid()) @db.VarChar(36)
  paymentId String @db.VarChar(36)
  providerRefundId String? @unique @db.VarChar(255)
  amountCents Int
  status String @default("REQUESTED") @db.VarChar(80)
  actorId String? @db.VarChar(36)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
}
