{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "db:generate": "cross-env DATABASE_URL=file:../database/dev.db prisma generate --schema ../prisma/schema.prisma",
    "db:push": "cross-env DATABASE_URL=file:../database/dev.db prisma db push --schema ../prisma/schema.prisma",
    "seed": "cross-env DATABASE_URL=file:../database/dev.db tsx src/seed.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepreview:emails": "npm run build",
    "preview:emails": "node scripts/preview-emails.mjs",
    "pretest": "npm run build",
    "test": "node --import ./test/source-loader.mjs --test --test-isolation=none test/*.test.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.21.1",
    "express-session": "^1.18.1",
    "multer": "^1.4.5-lts.1",
    "prisma": "^5.22.0",
    "sqlite3": "^6.0.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.5",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
